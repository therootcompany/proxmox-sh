#!/bin/sh
set -e
set -u

fn_version() (
	echo "proxmox-create v0.2026.11.03-1"
)

goto_env_init() {
	# shellcheck disable=SC1090
	. "${1}"

	g_show_help=''
	if test -z "${PROXMOX_VNET:-}" && test -z "${PROXMOX_BRIDGE:-}"; then
		g_show_help='1'
	fi
	if test -n "${PROXMOX_VNET:-}" && test -n "${PROXMOX_BRIDGE:-}"; then
		echo "You must set either 'PROXMOX_VNET' or 'PROXMOX_BRIDGE', but not both" >&2
		return 1
	fi

	PROXMOX_ID_PREFIX="${PROXMOX_ID_PREFIX:-${PROXMOX_ID_VLAN:-}}"
	PROXMOX_ID_START="${PROXMOX_ID_START:-51}"
	PROXMOX_ID_END="${PROXMOX_ID_END:-249}"

	if test -n "${g_show_help:-}" ||
		{ test -z "${PROXMOX_BASE_URL:-}" && test -z "${PROXMOX_HOST:-}"; } ||

		# Private Networking
		# VNET and BRIDGE checked above

		# DNS Defaults
		test -z "${PROXMOX_NAMESERVER:-}" ||
		test -z "${PROXMOX_SEARCH_DOMAIN:-}" ||

		# Instance Details
		test -z "${PROXMOX_TARGET_NODE:-}" ||
		test -z "${PROXMOX_ID_PREFIX:-}" ||
		test -z "${PROXMOX_ID_START:-}" ||
		test -z "${PROXMOX_RESOURCE_POOL:-}" ||
		test -z "${PROXMOX_TEMPLATE_STORAGE:-}" ||
		test -z "${PROXMOX_TEMPLATE_DEFAULT:-}" ||
		test -z "${PROXMOX_FS_POOL:-}" ||
		test -z "${PROXMOX_DATA_POOL:-}" ||

		# SSH Keys
		test -z "${PROXMOX_AUTHORIZED_KEYS:-}" ||

		# Direct IP for TLS Routing
		test -z "${DIRECT_IP_DOMAIN:-}" ||

		# HA_ENABLE is optional

		# Secrets
		test -z "${PROXMOX_TOKEN_ID:-}" ||
		test -z "${PROXMOX_TOKEN_SECRET:-}"; then

		# shellcheck disable=2016,2088
		{
			echo "~/.config/proxmox-sh/current.env is missing one or more variables."
			echo "Set all required variables using this:"
			echo ""
			cat "$(dirname "${0}")/../example.proxmox-sh.env"
			echo ""
			echo "Error: missing required environment variables"
			echo "       (see above for example)"
		} >&2
		exit 1
	fi

	my_auth="Authorization: PVEAPIToken=${PROXMOX_TOKEN_ID}=${PROXMOX_TOKEN_SECRET}"
	if test -n "${PROXMOX_BASE_URL:-}"; then
		case "${PROXMOX_BASE_URL}" in
			http*) ;;
			*)
				echo "Error: PROXMOX_BASE_URL must begin with 'http'" >&2
				exit 1
				;;
		esac
		my_base_url="${PROXMOX_BASE_URL%/}"
	else
		my_base_url="https://${PROXMOX_HOST}/api2/json"
	fi
}

fn_curl() (
	b_url="$(fn_curl_last_arg "$@")"
	b_resp_file="$(mktemp)"
	trap 'rm -f "${b_resp_file}"' EXIT

	if test -n "${TLS_ROUTER_AUTH:-}"; then
		b_http_code="$(
			curl --max-time 15 --fail-with-body -sSL \
				-H "X-TLS-Router-Auth: ${TLS_ROUTER_AUTH}" \
				-w '%{http_code}' -o "${b_resp_file}" \
				"$@" 2> /dev/null
		)" || true
	else
		b_http_code="$(
			curl --max-time 15 --fail-with-body -sSL \
				-w '%{http_code}' -o "${b_resp_file}" \
				"$@" 2> /dev/null
		)" || true
	fi

	if test "${b_http_code}" -ge 400 2> /dev/null || test -z "${b_http_code}"; then
		{
			echo ""
			echo "ERROR: curl request failed"
			echo "    URL:    ${b_url}"
			echo "    HTTP:   ${b_http_code:-000}"
			b_body="$(cat "${b_resp_file}" 2> /dev/null)"
			if test -n "${b_body}"; then
				echo "    body:   $(echo "${b_body}" | head -n 1)"
			fi
		} >&2
		return 1
	fi

	cat "${b_resp_file}"
)

fn_curl_last_arg() (
	while test "$#" -gt 1; do
		shift
	done
	echo "${1}"
)

fn_discover() (
	echo "${my_base_url}/"
	fn_curl -H "${my_auth}" \
		"${my_base_url}/" |
		jq '.'
)

fn_status() (
	echo "${my_base_url}/nodes/${PROXMOX_TARGET_NODE}/status"
	fn_curl -H "${my_auth}" \
		"${my_base_url}/nodes/${PROXMOX_TARGET_NODE}/status" |
		jq '.' | tee /dev/stderr
)

fn_lxc_last_id() (
	#echo "${my_base_url}/nodes/${PROXMOX_TARGET_NODE}/lxc"
	my_lxcs="$(
		fn_curl -H "${my_auth}" \
			"${my_base_url}/nodes/${PROXMOX_TARGET_NODE}/lxc"
	)"
	my_lxc_last_id="$(
		echo "${my_lxcs}" |
			jq -r '.data[].vmid' | sort | tail -n 1
	)"
	my_lxc_next_id="$((my_lxc_last_id + 1))"
	echo "${my_lxc_next_id}"
)

fn_resources_next_index() (
	my_prefix="${1}"

	# Or https://192.168.0.101:8006/api2/json/cluster/nextid ?
	#echo "${my_base_url}/cluster/resources"
	my_resources="$(
		fn_curl -H "${my_auth}" \
			"${my_base_url}/cluster/resources"
	)"

	my_resource_ids="$(
		echo "${my_resources}" |
			jq -r '.data[].vmid' |
			grep "^${my_prefix}" || true
	)"
	if test -z "${my_resource_ids}"; then
		echo "${PROXMOX_ID_START}"
		return
	fi

	my_used_suffixes="$(
		echo "${my_resource_ids}" |
			while read -r my_rid; do
				echo "$((my_rid % 1000))"
			done |
			sort -n -u
	)"

	my_id_start="${PROXMOX_ID_START}"
	my_id_end="${PROXMOX_ID_END}"
	if test "${my_id_start}" -lt 2; then
		my_id_start=2
	fi
	if test "${my_id_end}" -gt 254; then
		my_id_end=254
	fi

	my_next="${my_id_start}"
	while echo "${my_used_suffixes}" | grep -q "^${my_next}$"; do
		my_next="$((my_next + 1))"
		if test "${my_next}" -gt "${my_id_end}"; then
			echo "ERROR: no available IDs in prefix ${my_prefix} (range ${my_id_start}-${my_id_end})" >&2
			return 1
		fi
	done

	echo "${my_next}"
)

fn_ssh_keys() (
	my_key_uri="${1:-}"

	if test -z "${my_key_uri}"; then
		if ! command -v ssh-pubkey > /dev/null; then
			{
				echo ""
				echo "ERROR"
				echo "        'ssh-pubkey' does not exist and no ssh pubkey was given"
				echo ""
			} >&2

			return 1
		fi

		my_keys="$(
			ssh-pubkey 2> /dev/null
		)"
	fi

	my_keys="${my_key_uri}"
	case "${my_key_uri}" in
		http:*)
			echo "please use 'https://' for ssh public key urls"
			return 1
			;;
		https:*)
			my_keys="$(
				fn_curl "${my_key_uri}"
			)"
			;;
		*)
			if test -e "${my_key_uri}"; then
				my_keys="$(
					cat "${my_key_uri}"
				)"
			fi
			;;
	esac

	printf '%s' "${my_keys}" | grep -E '^(ssh|ecdsa)-[a-zA-Z0-9-]+ AAA' || true
)

fn_create_lxc() (
	# https://192.168.0.3:8006/api2/json/nodes/pve1/lxc

	my_target_node="${1}"
	my_vlan_param=""
	if test -n "${2:-}"; then
		my_vlan_param=",tag=${2}"
	fi
	my_next_unit="${3}"
	my_hostname="${4}"
	my_pubkeys="${5}"

	my_os_tmpl="${6}"
	my_memory="${7}"
	my_rootfs_size="${8}"
	my_mp0_size="${9}"
	my_cores="${10}"
	my_cpulimit="${11}"
	my_vmid="${12}"

	my_fs_size="${my_rootfs_size}"

	my_password="$(
		xxd -l12 -ps /dev/urandom |
			xxd -r -ps |
			base64 |
			tr -d = |
			tr + - |
			tr / _
	)"

	my_search_domain="${PROXMOX_SEARCH_DOMAIN:-}"
	my_nameserver="${PROXMOX_NAMESERVER:-}"
	my_bridge="${PROXMOX_VNET:-$PROXMOX_BRIDGE}"
	my_features='nesting=1'

	my_fs_pool="${PROXMOX_FS_POOL}"
	my_fs_opts='discard;lazytime;noatime'
	my_mp0_pool="${PROXMOX_DATA_POOL}"
	my_mp0_mnt='/mnt/storage'
	my_mp0_opts='discard;lazytime;noatime;nodev;nosuid'
	my_net="$(
		fn_id_to_net "${PROXMOX_ID_PREFIX}" "${my_next_unit}"
	)"

	# See POST at <https://pve.proxmox.com/pve-docs/api-viewer/#/nodes/{node}/lxc>
	echo POST "${my_base_url}/nodes/${my_target_node}/lxc" ... >> /dev/stderr
	my_task_result="$(
		fn_curl -H "${my_auth}" \
			-X POST "${my_base_url}/nodes/${my_target_node}/lxc" \
			--data-urlencode "features=${my_features}" \
			--data-urlencode "start=1" \
			--data-urlencode "onboot=1" \
			--data-urlencode "vmid=${my_vmid}" \
			--data-urlencode "hostname=${my_hostname}" \
			--data-urlencode "unprivileged=1" \
			--data-urlencode "pool=${PROXMOX_RESOURCE_POOL}" \
			--data-urlencode "password=${my_password}" \
			--data-urlencode "ssh-public-keys=${my_pubkeys}" \
			--data-urlencode "ostemplate=${my_os_tmpl}" \
			--data-urlencode "rootfs=${my_fs_pool}:${my_fs_size},mountoptions=${my_fs_opts}" \
			--data-urlencode "mp0=${my_mp0_pool}:${my_mp0_size},mp=${my_mp0_mnt},mountoptions=${my_mp0_opts},backup=1" \
			--data-urlencode "cores=${my_cores}" \
			--data-urlencode "cpulimit=${my_cpulimit}" \
			--data-urlencode "memory=${my_memory}" \
			--data-urlencode "swap=0" \
			--data-urlencode "net0=name=eth0,bridge=${my_bridge}${my_vlan_param},${my_net},rate=91" \
			--data-urlencode "searchdomain=${PROXMOX_ID_PREFIX}.${my_search_domain}" \
			--data-urlencode "nameserver=${my_nameserver}" | jq | tee /dev/stderr
	)"
	echo '' >> /dev/stderr
	#        --data-urlencode "arch=amd64" \

	#{"success":1,"data":"UPID:pve1:000C38ED:01978844:640D7BB1:vzcreate:101:root@pam:"}

	my_task_id="$(
		echo "${my_task_result}" |
			jq -r '.data' |
			grep '^UPID:' || true
	)"

	if test "${my_task_id}" = "null"; then
		echo ""
		echo "${my_task_result}" |
			jq '.'
		echo ""
		echo "Error: Create failed"
		echo ""
		exit 1
	fi

	echo "${my_task_id}"
)

fn_vm_check_image() (
	# my_volid: <storage>:import/<file>
	# PVE 9 lists storage content with ?content= (the old ?type= is rejected)
	my_volid="${1}"
	my_target_node="${2}"
	my_img_storage="${my_volid%%:*}"
	echo "GET ${my_base_url}/nodes/${my_target_node}/storage/${my_img_storage}/content?content=import ..." >> /dev/stderr
	my_contents="$(
		fn_curl -H "${my_auth}" \
			"${my_base_url}/nodes/${my_target_node}/storage/${my_img_storage}/content?content=import"
	)"
	if ! echo "${my_contents}" | jq -r '.data[]?.volid' | grep -qx "${my_volid}"; then
		echo "ERROR: image '${my_volid}' not found on storage '${my_img_storage}'" >&2
		return 1
	fi
	echo "${my_img_storage}"
)

fn_sshkeys_urlencode() (
	# PVE applies url-decoding to sshkeys a second time (after the standard
	# form-decode), so the value must be sent percent-encoded via
	# --data-urlencode: send raw and PVE rejects it with
	# "invalid format - invalid urlencoded string".
	my_out=''
	while IFS= read -r my_line; do
		my_enc="$(
			printf '%s' "${my_line}" |
				sed -e 's; ;%20;g' -e 's;+;%2B;g' -e 's;/;%2F;g' -e 's;=;%3D;g' -e 's;@;%40;g'
		)"
		if test -z "${my_out}"; then
			my_out="${my_enc}"
		else
			my_out="${my_out}%0A${my_enc}"
		fi
	done << EOF_KEYS
${1}
EOF_KEYS
	printf '%s' "${my_out}"
)

fn_create_vm() (
	# KVM cloud-init VM from a shared-storage import image (qcow2).
	# Unlike the single LXC POST, this is a fixed multi-call sequence:
	#   base VM -> cloud-init config (+disk import) -> cloud-init drive
	#   -> resize + boot order -> EXPLICIT ISO build -> start.
	# Every call is checked before the next.

	my_target_node="${1}"
	my_vlan_param=""
	if test -n "${2:-}"; then
		my_vlan_param=",tag=${2}"
	fi
	my_next_unit="${3}"
	my_hostname="${4}"
	my_pubkeys="${5}"
	my_vm_image="${6}"
	my_memory="${7}"
	my_disk_size="${8}"
	my_cores="${9}"
	my_cpulimit="${10}"
	my_vmid="${11}"
	my_cicustom="${12}"
	my_ciuser="${13}"
	my_extra_disk="${14}"

	my_password="$(
		xxd -l12 -ps /dev/urandom |
			xxd -r -ps |
			base64 |
			tr -d = |
			tr + - |
			tr / _
	)"

	my_search_domain="${PROXMOX_SEARCH_DOMAIN:-}"
	# PVE VM nameserver must be space-separated (commas render as one entry)
	my_nameserver="$(echo "${PROXMOX_NAMESERVER:-}" | tr ',' ' ')"
	my_bridge="${PROXMOX_VNET:-$PROXMOX_BRIDGE}"
	my_fs_pool="${PROXMOX_FS_POOL}"
	my_net="$(
		fn_id_to_net "${PROXMOX_ID_PREFIX}" "${my_next_unit}"
	)"
	my_mac="$(echo "${my_net}" | sed -nE 's/^hwaddr=([^,]+),.*/\1/p')"
	my_ipconfig="$(echo "${my_net}" | sed -nE 's/^hwaddr=[^,]+,//p')"

	# my_cicustom is computed in main() (--civendor flag, image-alias default, or PROXMOX_* env)

	# sshkeys must arrive already urlencoded (see fn_sshkeys_urlencode)
	my_sshkeys_enc="$(
		fn_sshkeys_urlencode "${my_pubkeys}"
	)"

	my_img_storage="$(fn_vm_check_image "${my_vm_image}" "${my_target_node}")" || {
		echo "ERROR: image check failed" >&2
		return 1
	}

	# 1. base VM (onboot=1 goes here; verified in the final config either way)
	echo "POST ${my_base_url}/nodes/${my_target_node}/qemu ..." >> /dev/stderr
	my_task_result="$(
		fn_curl -H "${my_auth}" \
			-X POST "${my_base_url}/nodes/${my_target_node}/qemu" \
			--data-urlencode "vmid=${my_vmid}" \
			--data-urlencode "name=${my_hostname}" \
			--data-urlencode 'ostype=l26' \
			--data-urlencode "memory=${my_memory}" \
			--data-urlencode 'sockets=1' \
			--data-urlencode "cores=${my_cores}" \
			--data-urlencode "cpulimit=${my_cpulimit}" \
			--data-urlencode 'agent=1' \
			--data-urlencode 'scsihw=virtio-scsi-single' \
			--data-urlencode 'onboot=1' \
			--data-urlencode "pool=${PROXMOX_RESOURCE_POOL}" \
			--data-urlencode "net0=virtio=${my_mac},bridge=${my_bridge}${my_vlan_param},firewall=1"
	)" || {
		echo "ERROR: base VM create failed" >&2
		return 1
	}
	my_task_result="$(printf '%s' "${my_task_result}" | jq | tee /dev/stderr)"
	echo '' >> /dev/stderr

	# 2. cloud-init options + import the image into scsi0 (one call).
	#    cipassword is set even for keys-only: a locked account refuses
	#    key auth (Alpine).
	echo "POST ${my_base_url}/nodes/${my_target_node}/qemu/${my_vmid}/config (cloudinit+import) ..." >> /dev/stderr
	set --
	if test -n "${my_cicustom}"; then
		set -- --data-urlencode "cicustom=${my_cicustom}"
	fi
	if test -n "${my_ciuser}"; then
		set -- "$@" --data-urlencode "ciuser=${my_ciuser}"
	fi
	my_task_result="$(
		fn_curl -H "${my_auth}" \
			-X POST "${my_base_url}/nodes/${my_target_node}/qemu/${my_vmid}/config" \
			--data-urlencode "scsi0=${my_fs_pool}:0,import-from=${my_vm_image},format=raw" \
			--data-urlencode "ipconfig0=${my_ipconfig}" \
			--data-urlencode "nameserver=${my_nameserver}" \
			--data-urlencode "searchdomain=${PROXMOX_ID_PREFIX}.${my_search_domain}" \
			--data-urlencode "sshkeys=${my_sshkeys_enc}" \
			--data-urlencode "cipassword=${my_password}" \
			"$@"
	)" || {
		echo "ERROR: cloud-init config failed" >&2
		return 1
	}
	my_task_result="$(printf '%s' "${my_task_result}" | jq | tee /dev/stderr)"
	echo '' >> /dev/stderr

	# 3. cloud-init drive — distinct call; the short lazy form allocates
	#    the volume and builds the first ISO
	echo "POST ${my_base_url}/nodes/${my_target_node}/qemu/${my_vmid}/config (ide0) ..." >> /dev/stderr
	my_task_result="$(
		fn_curl -H "${my_auth}" \
			-X POST "${my_base_url}/nodes/${my_target_node}/qemu/${my_vmid}/config" \
			--data-urlencode "ide0=${my_fs_pool}:cloudinit,media=cdrom"
	)" || {
		echo "ERROR: cloud-init drive add failed" >&2
		return 1
	}
	my_task_result="$(printf '%s' "${my_task_result}" | jq | tee /dev/stderr)"
	echo '' >> /dev/stderr

	# 4. extra storage — plain scsi1 disk at final size from
	#     PROXMOX_DATA_POOL (same pool as the CT mountpoint); the guest's
	#     vendor template formats/mounts it at /mnt/storage
	echo "POST ${my_base_url}/nodes/${my_target_node}/qemu/${my_vmid}/config (scsi1) ..." >> /dev/stderr
	my_task_result="$(
		fn_curl -H "${my_auth}" \
			-X POST "${my_base_url}/nodes/${my_target_node}/qemu/${my_vmid}/config" \
			--data-urlencode "scsi1=${PROXMOX_DATA_POOL}:${my_extra_disk}"
	)" || {
		echo "ERROR: extra disk add failed" >&2
		return 1
	}
	my_task_result="$(printf '%s' "${my_task_result}" | jq | tee /dev/stderr)"
	echo '' >> /dev/stderr

	# 5. size + boot order
	echo "PUT ${my_base_url}/nodes/${my_target_node}/qemu/${my_vmid}/resize ..." >> /dev/stderr
	my_task_result="$(
		fn_curl -H "${my_auth}" \
			-X PUT "${my_base_url}/nodes/${my_target_node}/qemu/${my_vmid}/resize" \
			--data-urlencode 'disk=scsi0' \
			--data-urlencode "size=${my_disk_size}G"
	)" || {
		echo "ERROR: disk resize failed" >&2
		return 1
	}
	my_task_result="$(printf '%s' "${my_task_result}" | jq | tee /dev/stderr)"
	echo "POST ${my_base_url}/nodes/${my_target_node}/qemu/${my_vmid}/config (boot) ..." >> /dev/stderr
	my_task_result="$(
		fn_curl -H "${my_auth}" \
			-X POST "${my_base_url}/nodes/${my_target_node}/qemu/${my_vmid}/config" \
			--data-urlencode 'boot=order=scsi0'
	)" || {
		echo "ERROR: boot order set failed" >&2
		return 1
	}
	my_task_result="$(printf '%s' "${my_task_result}" | jq | tee /dev/stderr)"
	echo '' >> /dev/stderr

	# 6. EXPLICIT ISO build — without this call the ISO is stale, and a
	#    missing cicustom fails silently (ISO ships without vendor data)
	echo "PUT ${my_base_url}/nodes/${my_target_node}/qemu/${my_vmid}/cloudinit ..." >> /dev/stderr
	my_task_result="$(
		fn_curl -H "${my_auth}" \
			-X PUT "${my_base_url}/nodes/${my_target_node}/qemu/${my_vmid}/cloudinit"
	)" || {
		echo "ERROR: cloud-init ISO build failed" >&2
		return 1
	}
	my_task_result="$(printf '%s' "${my_task_result}" | jq | tee /dev/stderr)"
	echo '' >> /dev/stderr

	# 7. start
	echo "POST ${my_base_url}/nodes/${my_target_node}/qemu/${my_vmid}/status/start ..." >> /dev/stderr
	my_task_result="$(
		fn_curl -H "${my_auth}" \
			-X POST "${my_base_url}/nodes/${my_target_node}/qemu/${my_vmid}/status/start"
	)" || {
		echo "ERROR: VM start failed" >&2
		return 1
	}
	my_task_result="$(printf '%s' "${my_task_result}" | jq | tee /dev/stderr)"
	echo '' >> /dev/stderr

	my_task_id="$(
		echo "${my_task_result}" |
			jq -r '.data' |
			grep '^UPID:' || true
	)"

	if test "${my_task_id}" = "null"; then
		echo ""
		echo "${my_task_result}" | jq '.'
		echo ""
		echo "Error: Start failed"
		echo ""
		exit 1
	fi

	echo "${my_task_id}"
)

fn_ha_groups_list() (
	fn_curl -H "${my_auth}" \
		"${my_base_url}/cluster/ha/groups" | jq -r '.data[].group'
)

fn_ha_resources_add() (
	# See POST at <https://pve.proxmox.com/pve-docs/api-viewer/#/cluster/ha/resources>
	# https://192.168.0.3:8006/api2/json/cluster/ha/resources

	my_type="ct" # or vm
	my_sid="${1}"
	my_group="${2}"
	my_state="started"
	my_max_relocate="1"
	my_max_restart="1"
	my_comment=""

	fn_curl -H "${my_auth}" \
		-X POST "${my_base_url}/cluster/ha/resources" \
		--data-urlencode "type=${my_type}" \
		--data-urlencode "sid=${my_sid}" \
		--data-urlencode "group=${my_group}" \
		--data-urlencode "state=${my_state}" \
		--data-urlencode "max_relocate=${my_max_relocate}" \
		--data-urlencode "max_restart=${my_max_restart}" \
		--data-urlencode "comment=${my_comment}" |
		jq -r '.data'
)

# Example
# vlan=1109, suffix=142
# mac = 00:52:11:09:01:42
# gw = 10.11.9.1
fn_id_to_net() (
	# assumed to be always 4-digits (1101-1199)
	my_id_prefix="${1}"
	# assumed to be less than 4-digits (51-254)
	my_next_unit="${2}"

	# we subtract the "1100" prefix from "1108" because leading zeros ("08", "09") are invalid octal in $(())
	# 1109 => 11, 9
	my_id_prefix_12=$((my_id_prefix / 100))
	my_id_prefix_34=$((my_id_prefix - (my_id_prefix_12 * 100)))

	# 11 => '11', 9 => '09'
	my_id_prefix_012=$(printf '%02d' "${my_id_prefix_12}")
	my_id_prefix_034=$(printf '%02d' "${my_id_prefix_34}")

	# 1 => 0001
	# 154 => 0154
	my_3digit="$((my_next_unit + 1000))"
	my_3digit="$(echo "${my_3digit}" | cut -c'2-4')"
	my_4digit="0${my_3digit}"

	# 0001 => '00' '01'
	# 0154 => '01' '54'
	my_unit_12="$(echo "${my_4digit}" | cut -c'1-2')"
	my_unit_34="$(echo "${my_4digit}" | cut -c'3-4')"

	# 1 => 101
	# 154 => 254
	my_ip_suffix="${my_next_unit}"

	printf "hwaddr=00:52:%s:%s:%s:%s," \
		"${my_id_prefix_012}" "${my_id_prefix_034}" "${my_unit_12}" "${my_unit_34}"
	printf "ip=10.%s.%s.%s/24," \
		"${my_id_prefix_12}" "${my_id_prefix_34}" "${my_ip_suffix}"
	printf "gw=10.%s.%s.1" \
		"${my_id_prefix_12}" "${my_id_prefix_34}"
)

fn_wait_status() (
	my_target_node="${1}"
	my_task_id_raw="${2}"
	my_check_count="${3:-1}"

	my_task_id="$(
		printf '%s' "${my_task_id_raw}" |
			xxd -plain |
			tr -d '\n' |
			sed 's/\(..\)/%\1/g'
	)"

	#echo "GET ${my_base_url}/nodes/${my_target_node}/tasks/<escape(${my_task_id_raw})>/status"
	my_task_result="$(
		fn_curl -H "${my_auth}" \
			"${my_base_url}/nodes/${my_target_node}/tasks/${my_task_id}/status" # | jq | tee /dev/stderr
	)"
	#echo ''

	my_task_status="$(
		printf '%s' "${my_task_result}" |
			jq -r '.data.status'
	)"
	echo ''
	echo "Status: ${my_task_status}"
	my_exit_status="$(
		printf '%s' "${my_task_result}" |
			jq -r '.data.exitstatus'
	)"
	if test "$my_exit_status" != "null" && test "$my_exit_status" != "OK"; then
		printf '%s' "${my_task_result}" | jq || true
		echo ""
		echo "ERROR:"
		echo "   ${my_exit_status:-Unknown Error}"
		return 1
	fi

	if test "${my_task_status}" = "running"; then
		if test "${my_check_count}" -ge 30; then
			echo "Error: tried 30 times"
			return 1
		fi

		sleep 1
		my_check_count="$((my_check_count + 1))"
		fn_wait_status "${my_target_node}" "${my_task_id_raw}" "${my_check_count}"
		return 0
	fi

	echo "${my_task_result}" | jq '.'
)

# TODO
# https://192.168.0.3:8006/api2/json/pools
# https://192.168.0.3:8006/api2/json/nodes
# https://192.168.0.3:8006/api2/json/nodes/pve1/network?type=any_bridge

fn_help() (
	my_pubkeys="${1:-}"

	echo ""
	echo "USAGE"
	echo "    proxmox-create [flags] <hostname> [ssh-pubkey-file-url-or-string]"
	echo ""
	echo "EXAMPLES"
	echo "    proxmox-create --env 'dev' --os alpine23 'service-01' ~/.ssh/id_ed25519.pub"
	echo ""
	echo "    proxmox-create --env 'dev' --os debian13 \\"
	echo "        --ram 1024 'log-server'"
	echo ""
	echo "    proxmox-create --env 'dev' --kvm debian13 'web-01'"
	echo ""
	echo "    proxmox-create --env 'dev' --kvm alpine24 --ciuser app 'web-01'"
	echo ""
	echo "    proxmox-create --env 'dev' --import 'sharedstor:import/debian-13-genericcloud-amd64.qcow2' \\"
	echo "        'web-01'"
	echo ""
	echo "OPTIONS"
	echo "    --env 'dev'           # name resolves to ~/.config/proxmox-sh/<name>.env (default: current.env)"
	echo "    --target-node 'pve1'  # pve1, pve2, pve3, or pve4 (default: PROXMOX_TARGET_NODE from env)"
	echo "    --os 'alpine23'       # LXC container: an OS alias in the form of 'alpine23'"
	echo "                          # (alpine23,20,19,18,17 bnna / ubuntu24,22,20 / debian13,12 standard)"
	echo "                          # or a template: [storage:]vztmpl/alpine-3.23-bnna_....tar.zst"
	echo "                          # (aliases: --ct, --template; default: PROXMOX_TEMPLATE_STORAGE:PROXMOX_TEMPLATE_DEFAULT from env)"
	echo "    --kvm 'debian13'      # KVM cloud-init VM: an image alias in the form of 'debian13'"
	echo "                          # (debian13, debian12, alpine24, ubuntu24)"
	echo "                          # or an image: [storage:]import/<file>.qcow2 (alias: --import)"
	echo "    --civendor 'debian13' # vendor template (cicustom vendor=): the --kvm <image>"
	echo "                          # (debian13, debian12, alpine24, ubuntu24), '<file>.yaml',"
	echo "                          # 'storage-name:snippets/<file>.yaml', or 'none'"
	echo "                          # (default: follows --kvm: civendor-<image>.yaml from PROXMOX_SNIPPET_STORAGE)"
	echo "    --ciuser 'app'       # cloud-init user to create and log in as (default: app)"
	echo "    --os/--ct/--template and --kvm/--import are mutually exclusive (CT or VM)"
	echo "    --vcpus 2             # range: 1-12"
	echo "    --vcpu-limit 1.5      # range: 0.01 to --vcpus (default: --vcpus, i.e. no throttling)"
	echo "    --ram 512             # range: 64-24576 MB"
	echo "    --extra-storage 0.1   # range: 0.1-250.0 GB, /mnt/storage"
	echo "    --os-storage 8        # range: 0.2-50.0 GB, / rootfs"
	echo ""

	if test -n "${my_pubkeys}"; then
		echo "DEFAULT SSH KEYS (only key comments are shown, for brevity)"
		printf '%s' "${my_pubkeys}" |
			cut -d' ' -f3 |
			sort -u |
			while read -r my_comment; do
				echo "    ${my_comment}"
			done
		echo ""
	fi
)

fn_show_next() (
	printf "Finding next available IP for vlan%s...\n" "${PROXMOX_ID_PREFIX}"
	my_id_prefix_1="$(
		echo "${PROXMOX_ID_PREFIX}" | cut -c-2
	)"
	my_id_prefix_1=$((my_id_prefix_1 + 0))

	my_id_prefix_2="$(
		echo "${PROXMOX_ID_PREFIX}" | cut -c3-
	)"
	my_id_prefix_2=$((my_id_prefix_2 + 0))

	my_next_unit="$(
		fn_resources_next_index "${PROXMOX_ID_PREFIX}"
	)"
	my_ip="10.${my_id_prefix_1}.${my_id_prefix_2}.${my_next_unit}"
	echo "    ${my_ip}"
	echo "    255.255.255.0 (/24)"
)

main() (
	my_env=''
	my_target_node=''
	my_hostname=''
	my_pubkeys=''
	my_os_tmpl=''
	my_vm=''
	my_vm_image=''
	my_vm_alias=''
	my_civendor=''
	my_cicustom=''
	my_ciuser=''
	my_os_given=''
	my_vcpus='2'
	my_vcpu_limit=''
	my_ram='512'
	my_extra_storage='0.1'
	my_os_storage='8'
	my_ha_group=''

	case "${1:-}" in
		version | --version | -V)
			fn_version >&2
			return 0
			;;
	esac

	while test -n "${1:-}"; do
		b_arg="${1:-}"
		shift

		case "${b_arg}" in
			help | --help)
				fn_help >&2
				return 0
				;;
			--env)
				my_env="${1:-}"
				shift
				case "${my_env}" in
					*/*) ;; # file path
					*.env)
						if test -f "${my_env}"; then
							my_env="./${my_env}"
						else
							my_env="${HOME}/.config/proxmox-sh/${my_env}"
						fi
						;;
					*)
						my_env="${HOME}/.config/proxmox-sh/${my_env}.env"
						;;
				esac
				;;
			--kvm | --import)
				my_vm_image="${1:-}"
				if test -n "${my_vm_image}"; then
					shift
				fi
				case "${my_vm_image}" in
					import/* | *:import/*) ;;
					debian13)
						my_vm_image='import/debian-13-genericcloud-amd64.qcow2'
						my_vm_alias='debian13'
						;;
					debian12)
						my_vm_image='import/debian-12-genericcloud-amd64.qcow2'
						my_vm_alias='debian12'
						;;
					alpine24)
						my_vm_image='import/alpine-3.24.3-x86_64-cloudinit-r0.qcow2'
						my_vm_alias='alpine24'
						;;
					ubuntu24)
						my_vm_image='import/noble-server-cloudimg-amd64.qcow2'
						my_vm_alias='ubuntu24'
						;;
					*)
						{
							echo "ERROR: --kvm (alias: --import) must be an image alias in the form of 'debian13' (debian13, debian12, alpine24, ubuntu24), or an image in the form of 'import/<file>.qcow2' or 'storage-name:import/<file>.qcow2'"
							fn_help
						} >&2
						return 1
						;;
				esac
				my_vm='1'
				;;
			--iso)
				# undocumented; takes a value and errors
				if test -n "${1:-}"; then
					shift
				fi
				echo "ERROR: --iso is not supported" >&2
				return 1
				;;
			--ciuser)
				my_ciuser="${1:-}"
				if test -n "${my_ciuser}"; then
					shift
				fi
				;;
			--civendor)
				my_civendor="${1:-}"
				if test -n "${my_civendor}"; then
					shift
				fi
				case "${my_civendor}" in
					none) ;;
					*:snippets/*) ;;
					*.*) ;;
					debian13 | debian12 | alpine24 | ubuntu24 | alpine24-wan)
						my_civendor="civendor-${my_civendor}.yaml"
						;;
					*)
						{
							echo "ERROR: --civendor must be an image name (debian13, debian12, alpine24, ubuntu24), 'none', a file '<file>.yaml', or 'storage-name:snippets/<file>.yaml'"
							fn_help
						} >&2
						return 1
						;;
				esac
				;;
			--target-node)
				my_target_node="${1:-}"
				case "${my_target_node}" in
					pve1 | pve2 | pve3 | pve4) ;;
					*)
						echo "ERROR: --target-node must be 'pve1', 'pve2', 'pve3', or 'pve4'" >&2
						fn_help >&2
						return 1
						;;
				esac
				shift
				;;
			--ct | --os | --template)
				my_os="${1:-}"
				my_os_given='1'
				shift

				case "${my_os}" in
					'') ;;
					vztmpl/* | *:vztmpl/*)
						my_os_tmpl="${my_os}"
						;;
					alpine23)
						my_os_tmpl='vztmpl/alpine-3.23-bnna_20260116_amd64.tar.zst'
						;;
					alpine20)
						my_os_tmpl='vztmpl/alpine-3.20-bnna_20240908_20241212_amd64.tar.zst'
						;;
					alpine19)
						my_os_tmpl='vztmpl/alpine-3.19-bnna_20240207_20241212_amd64.tar.zst'
						;;
					alpine18)
						my_os_tmpl='vztmpl/alpine-3.18-bnna_20230607_20241212_amd64.tar.zst'
						;;
					alpine17)
						my_os_tmpl='vztmpl/alpine-3.17-bnna_20221129_20241212_amd64.tar.zst'
						;;
					debian13)
						my_os_tmpl='vztmpl/debian-13-standard_13.6-1_amd64.tar.zst'
						;;
					debian12)
						my_os_tmpl='vztmpl/debian-12-standard_12.12-1_amd64.tar.zst'
						;;
					ubuntu24)
						my_os_tmpl='vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst'
						;;
					ubuntu22)
						my_os_tmpl='vztmpl/ubuntu-22.04-standard_22.04-1_amd64.tar.zst'
						;;
					ubuntu20)
						my_os_tmpl='vztmpl/ubuntu-20.04-standard_20.04-1_amd64.tar.gz'
						;;
					*)
						{
							echo "ERROR: --os (aliases --ct/--template) must be an OS alias in the form of 'alpine23', or a template in the form of 'vztmpl/debian-13-standard_13.6-1_amd64.tar.zst' or 'storage-name:vztmpl/...'"
							fn_help
						} >&2
						return 1
						;;
				esac

				;;
			--vcpus)
				my_vcpus="${1:-}"
				if test "${my_vcpus}" -lt 1 ||
					test "${my_vcpus}" -gt 12; then
					echo "ERROR: --vcpus must be between 1 and 12 (vCPUs)" >&2
					fn_help >&2
					return 1
				fi
				shift
				;;
			--vcpu-limit)
				my_vcpu_limit="${1:-}"
				if test -z "${my_vcpus:-}"; then
					echo "ERROR: --vcpus <n> must be set before --vcpu-limit <f>" >&2
					fn_help >&2
					return 1
				fi
				if echo "${my_vcpu_limit} < 0.01 || ${my_vcpu_limit} > ${my_vcpus}" | bc -l | grep -q 1; then
					echo "ERROR: --vcpu-limit must be between 0.01 and ${my_vcpus}" >&2
					fn_help >&2
					return 1
				fi
				shift
				;;
			--duty-cycle)
				echo "WARN: --duty-cycle is ignored" >&2
				shift
				;;
			--ram)
				my_ram="${1:-}"
				if test "${my_ram}" -lt 64 ||
					test "${my_ram}" -gt 24576; then
					echo "ERROR: --ram must be between 64 and 24576 (megabytes)" >&2
					fn_help >&2
					return 1
				fi
				shift
				;;
			--extra-storage | --storage)
				my_extra_storage="${1:-}"
				if echo "${my_extra_storage} < 0.1 || ${my_extra_storage} > 250.0" | bc -l | grep -q 1; then
					echo "ERROR: --extra-storage must be between 0.1 and 250.0 (gigabytes)" >&2
					fn_help >&2
					return 1
				fi
				shift
				;;
			--os-storage)
				my_os_storage="${1:-}"
				if echo "${my_os_storage} < 0.2 || ${my_os_storage} > 50.0" | bc -l | grep -q 1; then
					echo "ERROR: --os-storage must be between 0.2 and 50.0 (gigabytes)" >&2
					fn_help >&2
					return 1
				fi
				shift
				;;
			--*)
				echo "ERROR: ${b_arg} is not a known flag" >&2
				fn_help >&2
				return 1
				;;
			*)
				if test -z "${my_hostname}"; then
					my_hostname="${b_arg}"
					continue
				fi
				if test -z "${my_pubkeys}"; then
					my_pubkeys="${b_arg}"
					continue
				fi
				echo "ERROR: '${b_arg}' is not a known argument" >&2
				fn_help >&2
				return 1
				;;
		esac
	done

	if test -n "${my_os_given}" && test -n "${my_vm}"; then
		echo "ERROR: --os (aliases --ct/--template) and --kvm (alias --import) are mutually exclusive: create either an LXC container or a KVM VM" >&2
		fn_help >&2
		return 1
	fi
	: "${my_env:=${HOME}/.config/proxmox-sh/current.env}"
	if test ! -f "${my_env}"; then
		if test "${my_env}" = ~/.config/proxmox-sh/current.env; then
			>&2 echo "ERROR: '${my_env}' not found (run proxmox-sh-init)"
		else
			>&2 echo "ERROR: '${my_env}' not found"
		fi
		return 2
	fi

	goto_env_init "${my_env}"
	{
		if test -L "${my_env}"; then
			# shellcheck disable=SC2012
			ls -l "${my_env}" | sed 's;.* /;/;'
		fi

		echo "PROXMOX_BASE_URL=${my_base_url}"
		echo "PROXMOX_TARGET_NODE=${PROXMOX_TARGET_NODE:-}"
		echo "PROXMOX_ID_PREFIX=${PROXMOX_ID_PREFIX:-}"
		if test -n "${PROXMOX_VNET:-}" || test -z "${PROXMOX_BRIDGE:-}"; then
			echo "PROXMOX_VNET=${PROXMOX_VNET:-}"
		else
			echo "PROXMOX_BRIDGE=${PROXMOX_BRIDGE:-}"
			echo "PROXMOX_VLAN=${PROXMOX_VLAN:-}"
		fi
		echo "PROXMOX_SEARCH_DOMAIN=${PROXMOX_SEARCH_DOMAIN:-}"
		echo "DIRECT_IP_DOMAIN=${DIRECT_IP_DOMAIN:-}"
	} >&2

	: "${my_target_node:=${PROXMOX_TARGET_NODE}}"
	if test -n "${PROXMOX_HA_ENABLE:-}"; then
		: "${my_ha_group:=prefer-${my_target_node}}"
	fi

	: "${my_os_tmpl:=${PROXMOX_TEMPLATE_STORAGE}:${PROXMOX_TEMPLATE_DEFAULT}}"
	case "${my_os_tmpl}" in
		*:vztmpl/*) ;;
		*)
			my_os_tmpl="${PROXMOX_TEMPLATE_STORAGE}:${my_os_tmpl}"
			;;
	esac

	if test -n "${my_vm}"; then
		case "${my_vm_image}" in
			import/*)
				if test -n "${PROXMOX_IMPORT_STORAGE:-}"; then
					my_vm_image="${PROXMOX_IMPORT_STORAGE}:${my_vm_image}"
				else
					echo "ERROR: image '${my_vm_image}' has no storage; set PROXMOX_IMPORT_STORAGE, or use the full 'storage-name:import/<file>.qcow2' form" >&2
					fn_help >&2
					return 1
				fi
				;;
		esac
	fi
	# VMs default to an 'app' cloud-init user (PVE's own default is root,
	# which e.g. Alpine refuses key auth for)
	if test -n "${my_vm}" && test -z "${my_ciuser}"; then
		my_ciuser='app'
	fi

	if test -n "${my_civendor}" && test "${my_civendor}" != "none"; then
		case "${my_civendor}" in
			*:snippets/*)
				my_cicustom="vendor=${my_civendor}"
				;;
			*)
				if test -n "${PROXMOX_SNIPPET_STORAGE:-}"; then
					my_cicustom="vendor=${PROXMOX_SNIPPET_STORAGE}:snippets/${my_civendor}"
				else
					echo "ERROR: civendor '${my_civendor}' has no storage; set PROXMOX_SNIPPET_STORAGE, or use the full 'storage-name:snippets/<file>.yaml' form" >&2
					fn_help >&2
					return 1
				fi
				;;
		esac
	elif test "${my_civendor}" != "none" && test -n "${my_vm_alias}" && test -n "${PROXMOX_SNIPPET_STORAGE:-}"; then
		# image aliases default to their matching civendor template
		my_cicustom="vendor=${PROXMOX_SNIPPET_STORAGE}:snippets/civendor-${my_vm_alias}.yaml"
	elif test -n "${PROXMOX_VENDOR_SNIPPET:-}" && test -n "${PROXMOX_SNIPPET_STORAGE:-}"; then
		my_cicustom="vendor=${PROXMOX_SNIPPET_STORAGE}:snippets/${PROXMOX_VENDOR_SNIPPET}"
	fi
	if test -z "${my_vcpu_limit}"; then
		my_vcpu_limit="${my_vcpus}"
	fi

	if test -z "${my_pubkeys}"; then
		my_pubkeys="${PROXMOX_AUTHORIZED_KEYS:-}"
	fi

	my_pubkeys="$(
		fn_ssh_keys "${my_pubkeys}"
	)"

	if test -z "${my_hostname:-}"; then
		{
			echo "ERROR: hostname argument is required"
			fn_help "${my_pubkeys}"
			fn_show_next
			echo "ERROR: hostname argument is required"
		} >&2
		return 1
	fi
	if echo "${my_hostname}" | grep -q -F '.'; then
		echo "'hostname' should be the short form: i.e. 'foo', not 'foo.example.com'"
		return 1
	fi

	printf "Finding next available id for prefix %s... " "${PROXMOX_ID_PREFIX}" >&2
	my_next_unit="$(
		fn_resources_next_index "${PROXMOX_ID_PREFIX}"
	)"
	echo "${my_next_unit}" >&2

	my_net="$(
		fn_id_to_net "${PROXMOX_ID_PREFIX}" "${my_next_unit}"
	)"
	my_ip="$(
		echo "${my_net}" |
			tr ',' '\n' |
			grep 'ip=' |
			cut -d'=' -f2 |
			cut -d'/' -f1
	)"

	# This adds leading zeros
	# first: 1 => 1001
	my_3digit="$((my_next_unit + 1000))"
	# then:  1001 => 001
	my_3digit="$(echo "${my_3digit}" | cut -c'2-4')"
	my_vmid="${PROXMOX_ID_PREFIX}${my_3digit}"

	if test -n "${my_vm}"; then
		my_id_name='vmid'
		my_os_display="    OS (image):    ${my_vm_image}"
	else
		my_id_name='ctid'
		my_os_display="    OS:            ${my_os_tmpl}"
	fi

	{
		echo ""
		echo "    Host Node:     ${my_target_node}"
		echo "    ${my_id_name}:    ${my_vmid}"
		if test -n "${PROXMOX_HA_ENABLE:-}"; then
			echo "    HA Group:      ${my_ha_group}"
		else
			echo "    HA Group:      NOT ENABLED"
		fi
		echo ""
		echo "${my_os_display}"
		if test -n "${my_cicustom}"; then
			echo "    Civendor:    ${my_cicustom}"
		fi
		echo "    RAM:           ${my_ram}MB"
		echo "    / (rootfs):    ${my_os_storage}GB"
		echo "    /mnt/storage:  ${my_extra_storage}GB"
		echo "    vCPU:          ${my_vcpus} cores"
		echo "                   ${my_vcpu_limit} (usable)"
		echo ""
	} >&2

	if test -n "${my_vm}"; then
		my_task_id="$(
			fn_create_vm "${my_target_node}" "${PROXMOX_VLAN:-}" "${my_next_unit}" "${my_hostname}" "${my_pubkeys}" "${my_vm_image}" "${my_ram}" "${my_os_storage}" "${my_vcpus}" "${my_vcpu_limit}" "${my_vmid}" "${my_cicustom}" "${my_ciuser}" "${my_extra_storage}"
		)"
	else
		my_task_id="$(
			fn_create_lxc "${my_target_node}" "${PROXMOX_VLAN:-}" "${my_next_unit}" "${my_hostname}" "${my_pubkeys}" "${my_os_tmpl}" "${my_ram}" "${my_os_storage}" "${my_extra_storage}" "${my_vcpus}" "${my_vcpu_limit}" "${my_vmid}"
		)"
	fi
	{
		echo "Waiting for ${my_task_id}..."
		fn_wait_status "${my_target_node}" "${my_task_id}"
	} >&2

	if test -n "${PROXMOX_HA_ENABLE:-}"; then
		my_ha_groups="$(fn_ha_groups_list | grep '^prefer-')"
		if ! echo "${my_ha_groups}" | grep -q "^${my_ha_group}$"; then
			{
				printf "Warning: '%s' is not in the list of active HA Groups:\n\n%s\n\n" "${my_ha_group}" "${my_ha_groups}"
				echo "Please update manually"
			} >&2
			return 1
		fi
		if fn_ha_resources_add "${my_vmid}" "${my_ha_group}" > /dev/null; then
			echo >&2 "(also added '${my_vmid}' to HA Group '${my_ha_group}')"
		else
			echo >&2 "WARN: did not add '${my_vmid}' to HA Group '${my_ha_group}'"
		fi
	else
		{
			echo ""
			echo "Note: HA Groups cannot be modified by non-admin users."
			echo "      Update manually if needed."
		} >&2
	fi

	my_ip_label="$(echo "${my_ip}" | tr '.' '-')"
	my_ip_domain="tls-${my_ip_label}.${DIRECT_IP_DOMAIN:-$PROXMOX_ID_PREFIX.$PROXMOX_SEARCH_DOMAIN}"
	my_raw_ip_domain="tcp-${my_ip_label}.${DIRECT_IP_DOMAIN:-$PROXMOX_ID_PREFIX.$PROXMOX_SEARCH_DOMAIN}"

	# Poll for TLS readiness — the VM and ACME cert may take a moment
	echo ""
	printf "Waiting for TLS certificate issuance"
	b_tls_ok=''
	for b_tls_try in 1 2 3 4 5 6; do
		if echo '' | openssl s_client -connect "${my_ip_domain}:443" \
			-alpn 'ssh,h2,http/1.1' -servername "${my_ip_domain}" \
			2> /dev/null | grep -q 'BEGIN CERTIFICATE'; then
			b_tls_ok='1'
			break
		fi
		printf "."
		sleep 5
	done
	if test -n "${b_tls_ok}"; then
		echo " done"
	else
		echo "timed out (may still be provisioning)"
	fi

	{
		echo ""
		echo ">>> HOW TO ACCESS? <<<"
		echo ""
		echo "Domain Setup"
		echo "    -- typical: proxies http on 3080, ssh on 22 --"
		echo "    CNAME                ${my_hostname}.yoursite.com ${my_ip_domain}"
		echo "    -- raw: proxies tcp on 443, ssh on 22 --"
		echo "    CNAME                ${my_hostname}.yoursite.com ${my_raw_ip_domain}"
		echo "    -- typical, top-level domains: http on 3080, ssh on 22 --"
		my_ip_domain_ip="$(dig +short A "${my_ip_domain}")"
		echo "    A                    ${my_hostname}.yoursite.com ${my_ip_domain_ip}"
		echo "    SRV       _http._tcp.${my_hostname}.yoursite.com ${my_ip_domain}  3080"
		echo "    SRV       _http._tcp.${my_hostname}.yoursite.com ${my_ip_domain}  3080"
		echo "    -- advanced: direct h2 on 443, direct pg on 5432, decrypted mqtt on 11883 --"
		echo "    SRV         _h2._tcp.${my_hostname}.yoursite.com ${my_raw_ip_domain}   443"
		echo "    SRV       _http._tcp.${my_hostname}.yoursite.com ${my_raw_ip_domain}   443"
		echo "    SRV     _webrtc._tcp.${my_hostname}.yoursite.com ${my_raw_ip_domain}   443"
		echo "    SRV _postgresql._tcp.${my_hostname}.yoursite.com ${my_raw_ip_domain} 15432"
		echo "    SRV       _mqtt._tcp.${my_hostname}.yoursite.com ${my_ip_domain} 11883"
		echo "    (see https://github.com/bnnanet/tlsrouter for all supported protocols)"
		echo ""
		echo "TCP (raw, encrypted)"
		echo "    curl https://${my_raw_ip_domain} # proxies to port 443 (raw tls)"
		echo ""
		echo "HTTP (decrypted)"
		echo "    curl https://${my_ip_domain} # proxies plain http to port 3080 with X-Forwarded-* set"
		echo ""
		echo "SSH"
		echo "    ssh ${my_ip_domain}  # requires ProxyCommand sclient --alpn 'ssh' %h"
		echo ""
		echo "^^^ HOW TO ACCESS? ^^^"
	} >&2
)

main "${@:-}"
